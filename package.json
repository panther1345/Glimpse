{
  "name": "glimpse-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run icons && vite build && node scripts/build-content.mjs",
    "zip": "cd dist && rm -f ../glimpse.zip && zip -qr ../glimpse.zip ."
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "katex": "^0.19.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
